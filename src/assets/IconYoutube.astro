---
interface Props {
	class?: string;
	stroke?: string;
	filled?: string;
}

const { class: className = 'size-6', stroke = '2', filled = '' } = Astro.props;
const isFilled = filled === 'true';

const outlinePaths = [
	'M2 8a4 4 0 0 1 4 -4h12a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-12a4 4 0 0 1 -4 -4v-8',
	'M10 9l5 3l-5 3l0 -6',
];

const filledPath =
	'M18 3a5 5 0 0 1 5 5v8a5 5 0 0 1 -5 5h-12a5 5 0 0 1 -5 -5v-8a5 5 0 0 1 5 -5zm-9 6v6a1 1 0 0 0 1.514 .857l5 -3a1 1 0 0 0 0 -1.714l-5 -3a1 1 0 0 0 -1.514 .857z';
---

<svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24">
	<path stroke="none" d="M0 0h24v24H0z" fill="none" />
	{isFilled ? (
		<path fill="currentColor" d={filledPath} />
	) : (
		outlinePaths.map((path) => (
			<path fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" d={path} />
		))
	)}
</svg>

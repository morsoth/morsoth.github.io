---
interface Props {
	class?: string;
	stroke?: string;
}

const { class: className = 'size-6', stroke = '2' } = Astro.props;

const paths = [
	'M22 12h-2',
	'M2 9h4',
	'M2 15h4',
	'M5 19c1.778 -4.667 1.778 -9.333 0 -14',
	'M8 5c10.667 2.1 10.667 12.6 0 14c1.806 -4.667 1.806 -9.333 0 -14',
	'M16 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0',
];
---

<svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24">
	<path stroke="none" d="M0 0h24v24H0z" fill="none" />
	{paths.map((path) => (
		<path fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" d={path} />
	))}
</svg>

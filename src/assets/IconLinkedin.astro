---
interface Props {
	class?: string;
	stroke?: string;
	filled?: string;
}

const { class: className = 'size-6', stroke = '2', filled = '' } = Astro.props;
const isFilled = filled === 'true';

const outlinePaths = [
	'M8 11v5',
	'M8 8v.01',
	'M12 16v-5',
	'M16 16v-3a2 2 0 1 0 -4 0',
	'M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10',
];

const filledPath =
	'M17 2a5 5 0 0 1 5 5v10a5 5 0 0 1 -5 5h-10a5 5 0 0 1 -5 -5v-10a5 5 0 0 1 5 -5zm-9 8a1 1 0 0 0 -1 1v5a1 1 0 0 0 2 0v-5a1 1 0 0 0 -1 -1m6 0a3 3 0 0 0 -1.168 .236l-.125 .057a1 1 0 0 0 -1.707 .707v5a1 1 0 0 0 2 0v-3a1 1 0 0 1 2 0v3a1 1 0 0 0 2 0v-3a3 3 0 0 0 -3 -3m-6 -3a1 1 0 0 0 -.993 .883l-.007 .127a1 1 0 0 0 1.993 .117l.007 -.127a1 1 0 0 0 -1 -1';
---

<svg xmlns="http://www.w3.org/2000/svg" class={className} viewBox="0 0 24 24">
	<path stroke="none" d="M0 0h24v24H0z" fill="none" />
	{isFilled ? (
		<path fill="currentColor" d={filledPath} />
	) : (
		outlinePaths.map((path) => (
			<path fill="none" stroke="currentColor" stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" d={path} />
		))
	)}
</svg>

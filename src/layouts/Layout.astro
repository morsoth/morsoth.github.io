---
import '../styles/global.css'

import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import ScrollTopButton from '../components/ScrollTopButton.astro'

interface Props {
    title: string
    description?: string
}

const {
    title,
    description = 'Portfolio of Pau Zaragoza, electronics engineer focused on embedded systems, digital design, and low-level engineering.',
} = Astro.props
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <script is:inline>
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'dark') document.documentElement.classList.add('dark');
                if (theme === 'light') document.documentElement.classList.remove('dark');
            } catch {}
        </script>
        <title>{title}</title>
	</head>
    <body class="bg-background text-foreground font-sans transition">
		<Header />
        <slot />
		<ScrollTopButton />
		<Footer />
	</body>
</html>

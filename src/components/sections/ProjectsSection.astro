---
import IconBook from '../../assets/IconBook.astro';
import IconGithub from '../../assets/IconGithub.astro';
import IconStar from '../../assets/IconStar.astro';
import IconYoutube from '../../assets/IconYoutube.astro';
import Tag from '../Tag.astro';

const projects = [
	{
		title: 'Tydeus-16 Core',
		description: 'A simple 16-bit multicycle CPU core in VHDL, featuring a custom ISA, separate instruction and data memories, and a clean design.',
		repos: [
			{
				name: 'tydeus16-core',
				href: 'https://github.com/morsoth/tydeus16-core',
				tags: ['VHDL', 'CPU', 'Computer architecture'],
			},
			{
				name: 'athenisa',
				href: 'https://github.com/morsoth/athenisa',
				tags: ['Instruction Set Architecture'],
			},
		],
		wiki: '',
		video: '',
		featured: true,
	},
	{
		title: 'UART Module for FPGA',
		description: 'FPGA-based UART core featuring FIFO buffering and AXI4-Lite register access, with a minimal C driver for deterministic and low-level control.',
		repos: [
			{
				name: 'vhdl-uart-axi-module',
				href: 'https://github.com/morsoth/vhdl-uart-axi-module',
				tags: ['VHDL', 'C', 'FPGA', 'UART', 'AXI4-Lite'],
			},
		],
		wiki: '',
		video: '',
		featured: false,
	},
	{
		title: 'ZeOS',
		description: 'Basic x86 UNIX-like kernel implementation for the SO2 course. Runs space invaders.',
		repos: [
			{
				name: 'zeos',
				href: 'https://github.com/morsoth/zeos',
				tags: ['C', 'x86 Assembly', 'Operating system', 'Space invaders'],
			},
		],
		wiki: '',
		video: '',
		featured: false,
	},
];
---

<section id="projects" class="py-20">
	<h2 class="mb-10 font-code text-2xl font-black text-foreground">
		<span class="text-accent font-normal">02.</span> Projects
	</h2>

	<div class="flex flex-col gap-4">
		{projects.map((project) => (
			<article class={`relative rounded-lg bg-background p-5 ${project.featured ? 'outline-2 outline-accent -outline-offset-2' : 'border border-surface'}`}>
				<div class="flex items-start justify-between gap-4">
					<h3 class="text-xl font-semibold md:text-2xl">{project.title}</h3>
					<div class="flex gap-3 text-2xl">
						{project.featured && (
							<span class="absolute right-0 top-0 grid size-6 place-items-center rounded-sm bg-accent text-sm text-background">
								<IconStar class="size-3" filled="true" />
							</span>
						)}
						{project.wiki && (
							<a
								class="transition hover:text-accent"
								href={project.wiki}
								target="_blank"
								rel="noreferrer"
								aria-label={`${project.title} wiki`}
							>
								<IconBook class="size-6" stroke="2" />
							</a>
						)}
						{project.video && (
							<a
								class="transition hover:text-accent"
								href={project.video}
								target="_blank"
								rel="noreferrer"
								aria-label={`${project.title} video`}
							>
								<IconYoutube class="size-6" stroke="2" />
							</a>
						)}
					</div>
				</div>

				<p class="mt-3 text-pretty text-xs leading-5 text-muted sm:text-sm sm:leading-7">{project.description}</p>

				<div class="mt-6 flex flex-col gap-3">
					{project.repos.map((repo) => (
						<div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-x-4">
							<a
								class="font-code font-bold text-sm text-accent underline-offset-4 transition hover:underline"
								href={repo.href}
								target="_blank"
								rel="noreferrer"
							>
								/{repo.name}
							</a>
							<div class="flex flex-wrap gap-2">
								{repo.tags.map((tag) => (
									<Tag>{tag}</Tag>
								))}
							</div>
						</div>
					))}
				</div>
			</article>
		))}
	</div>

	<a
		class="mx-auto mt-10 flex w-fit items-center gap-2 rounded border border-surface bg-background px-5 py-3 font-code font-medium text-sm shadow-md shadow-foreground/10 transition hover:border-accent hover:text-accent"
		href="https://github.com/morsoth"
		target="_blank"
		rel="noreferrer"
	>
		<IconGithub class="size-5" stroke="2" />
		Github
	</a>
</section>

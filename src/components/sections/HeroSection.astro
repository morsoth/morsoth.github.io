---
import IconCv from '../../assets/IconCv.astro';
import IconGithub from '../../assets/IconGithub.astro';
import IconLinkedin from '../../assets/IconLinkedin.astro';
import IconLogicAnd from '../../assets/IconLogicAnd.astro';
---

<section class="flex min-h-dvh flex-col justify-center gap-5 py-20 lg:min-h-screen lg:gap-6 lg:py-0">
	<p class="font-code text-sm text-muted">Hi, my name is</p>

	<div>
		<h1 class="text-6xl font-bold leading-none tracking-tight text-foreground sm:text-7xl lg:text-8xl">
			Pau<span class="lg:hidden"><br /></span><span class="mt-2 inline-block lg:ml-5 lg:mt-0 lg:inline">Zaragoza</span>
			<span class="inline-block font-code text-lg font-medium leading-normal tracking-normal text-accent lg:inline">
				a.k.a.
				<a
					class="underline underline-offset-4 transition hover:text-foreground"
					href="https://github.com/morsoth"
					target="_blank"
					rel="noreferrer"
				>morsoth</a>
			</span>
		</h1>
	</div>

	<h2 class="flex items-center gap-3 whitespace-nowrap text-xl font-semibold text-muted sm:text-3xl lg:whitespace-normal lg:text-4xl">
		<IconLogicAnd class="size-7 shrink-0 text-surface sm:size-8 lg:size-10" stroke="2.5" />
		I'm an Electronics Engineer
	</h2>

	<p class="max-w-2xl text-pretty text-sm leading-6 text-muted sm:text-base sm:leading-7 lg:text-lg lg:leading-8">
		I build thoughtful hardware and software projects, blending embedded systems,
		clean interfaces, and practical engineering.
	</p>

	<div class="flex items-stretch gap-4">
		<a
			href="Pau_Zaragoza_CV.pdf"
			class="inline-flex items-center justify-center gap-2 rounded border border-surface bg-background px-4 py-2 font-code font-medium text-sm shadow-md shadow-foreground/10 transition hover:border-accent hover:text-accent"
			target="_blank"
			rel="noreferrer"
		>
			<IconCv class="size-5" stroke="1.75" />
			Resume
		</a>
		<a
			href="https://github.com/morsoth"
			class="inline-flex aspect-square items-center justify-center rounded border border-surface bg-background px-2 text-2xl shadow-md shadow-foreground/10 transition hover:border-accent hover:text-accent"
			aria-label="GitHub"
			target="_blank"
			rel="noreferrer"
		>
			<IconGithub class="size-6" stroke="1.5" filled="" />
		</a>
		<a
			href="https://www.linkedin.com/in/pau-zaragoza-gallardo-86b925274/"
			class="inline-flex aspect-square items-center justify-center rounded border border-surface bg-background px-2 text-2xl shadow-md shadow-foreground/10 transition hover:border-accent hover:text-accent"
			aria-label="LinkedIn"
			target="_blank"
			rel="noreferrer"
		>
			<IconLinkedin class="size-6" stroke="1.5" filled="" />
		</a>
	</div>
</section>

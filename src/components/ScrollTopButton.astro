---
import IconPower from '../assets/IconPower.astro';
---

<button
	id="scroll-top"
	class="fixed bottom-6 right-6 z-40 inline-flex size-10 translate-y-3 cursor-pointer items-center justify-center rounded-md border border-surface bg-background/60 text-surface opacity-0 shadow-md shadow-foreground/10 backdrop-blur-md transition hover:border-accent hover:text-accent pointer-events-none"
	type="button"
	aria-label="Scroll to top"
>
	<IconPower class="size-5" stroke="1.75" />
</button>

<script>
	const scrollTopButton = document.querySelector('#scroll-top');

	const updateScrollTopButton = () => {
		const isVisible = window.scrollY > 500;

		scrollTopButton?.classList.toggle('opacity-100', isVisible);
		scrollTopButton?.classList.toggle('translate-y-0', isVisible);
		scrollTopButton?.classList.toggle('pointer-events-auto', isVisible);
		scrollTopButton?.classList.toggle('opacity-0', !isVisible);
		scrollTopButton?.classList.toggle('translate-y-3', !isVisible);
		scrollTopButton?.classList.toggle('pointer-events-none', !isVisible);
	};

	scrollTopButton?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});

	updateScrollTopButton();
	window.addEventListener('scroll', updateScrollTopButton, { passive: true });
</script>
